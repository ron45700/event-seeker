# Copy to .env (the .env file is git-ignored)
DB_PATH=data/event_seeker.db
FETCH_INTERVAL_MINUTES=60
PORT=8765

# Email. EMAIL_ENABLED is a global switch for all subscribers. While false, no email
# is sent and alerts wait in the queue until it is turned on.
EMAIL_ENABLED=false
# SMTP_PASSWORD is a Gmail App Password, not the regular account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
