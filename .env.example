# Copy to .env (the .env file is git-ignored)
DB_PATH=data/event_seeker.db
FETCH_INTERVAL_MINUTES=60
PORT=8765

# Email. EMAIL_ENABLED is a global switch for all subscribers. While false, no email
# is sent and alerts wait in the queue until it is turned on.
EMAIL_ENABLED=false
# SMTP_PASSWORD is a Gmail App Password, not the regular account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Operator alerts (Telegram): a message when a source fails several runs in a row, and when
# it recovers. Leave both empty to turn them off; /health still shows the state.
# Token: from @BotFather. Chat id: send the bot a message, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and take message.chat.id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Failed runs in a row before the alert (one run per FETCH_INTERVAL_MINUTES)
SOURCE_ALERT_AFTER_FAILURES=3
